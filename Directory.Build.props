<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>

    <!--
      Suppressions live here, not in .editorconfig. See docs/CONVENTIONS.md.

      CS1591  missing XML comment. Summaries are written only where the code cannot say it.
      CA1716  'Error' collides with a VB keyword; nothing here is consumed from VB.
      CA1000  static members on generics, i.e. Result<T>.Ok.
      CA2007  ConfigureAwait: ASP.NET Core has no SynchronizationContext to capture.
      CA1062  <Nullable>enable</Nullable> already proves this at compile time.
    -->
    <NoWarn>$(NoWarn);CS1591;CA1716;CA1000;CA2007;CA1062</NoWarn>
  </PropertyGroup>

  <!-- CA1707: test names are Method_Scenario_ExpectedResult. -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('Tests'))">
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

</Project>
